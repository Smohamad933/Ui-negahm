<?xml version="1.0" encoding="UTF-8"?>
<!--
    این فایل کاملاً اختیاری است و هیچ URL Rewrite‌ای در آن استفاده نشده
    (چون کل سایت با URLهای querystring-محور کار می‌کند، نه مسیرهای زیبا).
    تنها کاری که می‌کند:
      ۱) اجازه‌ی سرو شدن فایل‌های فونت وب (woff2/woff) با mime-type درست را می‌دهد.
      ۲) دسترسی مستقیم به پوشه‌ی data/ (که فایل دیتابیس SQLite در آن است) را
         از طریق مرورگر می‌بندد، تا کسی نتواند فایل app.sqlite را دانلود کند.
    اگر IIS شما از قبل این mime-type‌ها را می‌شناسد یا اصلاً از ماژول
    staticContent استفاده نمی‌کنید، حذف این فایل هیچ مشکلی ایجاد نمی‌کند.
-->
<configuration>
    <system.webServer>
        <staticContent>
            <remove fileExtension=".woff" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        </staticContent>

        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="data" />
                    <add segment="install" />
                    <add segment="lib" />
                    <add segment="partials" />
                </hiddenSegments>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<!--
    نگاه مدیا — تنظیمات IIS

    این سایت با PHP خام (بدون فریم‌ورک) نوشته شده و از URLهای
    querystring-محور استفاده می‌کند (مثل client.php?slug=...)، پس به
    ماژول URL Rewrite نیازی نیست و این فایل عمداً از آن استفاده نمی‌کند
    (نصب آن ماژول روی سرورهایی که ندارندش می‌تواند باعث خطای
    "HTTP Error 500.19" شود، بنابراین این‌جا از rewrite صرف‌نظر شده).

    اگر بعد از آپلود سایت با خطای 403/500.19 یا نمایش سورس PHP به‌جای
    اجرای آن مواجه شدید، پایین همین فایل و بخش «PHP FastCGI Handler»
    در DEPLOY.md را حتماً بخوانید — این دقیقاً همان مشکلی است که قبلاً
    یک‌بار در این پروژه پیش آمده و رفع شده بود.
-->
<configuration>
    <system.webServer>

        <!-- ================== Default Documents ================== -->
        <!--
          بعضی نصب‌های خام IIS (بدون PHP Manager) به‌صورت پیش‌فرض
          index.php را جزو Default Document نمی‌شناسند و در نتیجه آدرس
          ریشه‌ی سایت به‌جای اجرای index.php لیست پوشه یا صفحه‌ی خالی
          نشان می‌دهد. این بخش صریحاً index.php را اول لیست می‌گذارد.
        -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
                <add value="index.html" />
            </files>
        </defaultDocument>

        <!--
          ================== PHP FastCGI Handler (اختیاری/غیرفعال) ==================

          به‌صورت پیش‌فرض این بخش غیرفعال (کامنت) است، چون اضافه‌کردن یک
          Handler تکراری برای *.php وقتی PHP از قبل روی سرور (مثلاً از طریق
          "PHP Manager for IIS" یا تنظیمات سطح سرور) ثبت شده، با آن تداخل
          می‌کند و می‌تواند باعث خطای "403 - Forbidden" یا "500.19" شود
          (این دقیقاً همان اتفاقی است که یک‌بار در این پروژه افتاد و باعث
          شد این بخش از حالت پیش‌فرض حذف شود).

          **فقط و فقط** اگر PHP را کاملاً دستی و بدون هیچ ابزار مدیریتی روی
          IIS نصب کرده‌اید و مطمئن هستید هیچ Handler دیگری برای *.php در
          سطح سایت یا سرور وجود ندارد، کامنت زیر را بردارید و مسیر
          scriptProcessor را با مسیر واقعی php-cgi.exe روی سرور خودتان
          جایگزین کنید:

          <handlers>
            <add name="PHP_via_FastCGI" path="*.php" verb="*"
                 modules="FastCgiModule"
                 scriptProcessor="C:\php\php-cgi.exe"
                 resourceType="Either" />
          </handlers>
        -->

        <!-- ================== HTTP Errors ================== -->
        <!--
          "DetailedLocalOnly" یعنی جزئیات خطا فقط برای درخواست‌هایی که از
          خود سرور می‌آیند نمایش داده می‌شود (برای عیب‌یابی)، و بازدیدکننده‌های
          واقعی فقط پیام عمومی خطا را می‌بینند. حالت "Detailed" برای همه
          (از جمله بازدیدکنندگان بیرونی) جزئیات داخلی/مسیرهای سرور را فاش
          می‌کند و برای محیط عملیاتی توصیه نمی‌شود.
        -->
        <httpErrors errorMode="DetailedLocalOnly" />

        <!-- ================== Security / Request Filtering ================== -->
        <security>
            <requestFiltering>
                <!-- سقف حجم آپلود؛ کمی بیشتر از سقف ۲۰ مگابایتی خود برنامه
                     (lib/uploads.php) تا خطای واقعی از سمت PHP نمایش داده شود
                     نه یک 404/413 خشک از IIS. -->
                <requestLimits maxAllowedContentLength="33554432" />

                <!-- پوشه‌های داخلی/حساس که هرگز نباید مستقیم از مرورگر
                     قابل دسترسی باشند. توجه: پوشه‌ی dashbord/app اینجا
                     عمداً اضافه نشده چون آدرس ورود پنل مدیریت
                     (/dashbord/app/login.php) باید از بیرون در دسترس باشد. -->
                <hiddenSegments>
                    <add segment="data" />
                    <add segment="install" />
                    <add segment="lib" />
                    <add segment="partials" />
                </hiddenSegments>

                <!-- پسوندهایی که هرگز نباید مستقیم سرو شوند (حتی اگر کسی
                     مسیر دقیق فایل را حدس بزند) -->
                <fileExtensions>
                    <add fileExtension=".sqlite" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".lock" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <!-- ================== Static Content (MIME) ================== -->
        <staticContent>
            <remove fileExtension=".woff" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <remove fileExtension=".ttf" />
            <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
        </staticContent>

        <!-- ================== Security Headers ================== -->
        <httpProtocol>
            <customHeaders>
                <add name="X-Content-Type-Options" value="nosniff" />
            </customHeaders>
        </httpProtocol>

    </system.webServer>
</configuration>
